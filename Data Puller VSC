# --- DATA_FETCHER.PY: CLI Utility for Crypto Data & Feature Generation ---
# FIXED VERSION: Preserves the "Live" candle for accurate future prediction.
# CONVERTED FOR: ETH/USD (ETH/USDC)

import pandas as pd
import numpy as np
import ccxt
import ta
import sys
import argparse
import time
from typing import Tuple, Optional, List

# =========================================================================
# 1. UTILITY FUNCTIONS
# =========================================================================

def handle_kraken_symbol(exchange: ccxt.Exchange, symbol: str) -> str:
    """
    Handles Kraken's symbol naming conventions. 
    Updated to prioritize ETH pairs (ETH/USDC, ETH/USD).
    """
    if exchange.id != 'kraken':
        return symbol

    try:
        markets = exchange.load_markets()
    except Exception as e:
        print(f"❌ ERROR loading markets for Kraken: {e}")
        return symbol 

    # 1. Check if the requested symbol (e.g., ETH/USDC) exists directly
    if symbol in markets:
        return symbol
    
    # 2. If specific symbol not found, try standard ETH fallbacks on Kraken
    print(f"⚠️ WARNING: {symbol} not found exactly on Kraken. Attempting fallbacks...")
    
    if 'ETH/USDC' in markets:
        print(f"   -> Switching to ETH/USDC")
        return 'ETH/USDC'
    elif 'ETH/USD' in markets:
        print(f"   -> Switching to ETH/USD")
        return 'ETH/USD'
    elif 'ETH/USDT' in markets:
        print(f"   -> Switching to ETH/USDT")
        return 'ETH/USDT'
    else:
        # Return original if no fallbacks found
        return symbol

def fetch_historical_data(exchange: ccxt.Exchange, symbol: str, timeframe: str, target_limit: int, chunk_limit: int = 700) -> List[list]:
    """
    Iteratively fetches OHLCV data using pagination to overcome single-call limits.
    """
    all_ohlcv = []
    since = None
    fetched_count = 0
    
    print(f"🔄 Starting iterative fetch (Chunk Limit: {chunk_limit} per call)...")

    while fetched_count < target_limit:
        limit = min(chunk_limit, target_limit - fetched_count)
        
        try:
            ohlcv_chunk = exchange.fetch_ohlcv(symbol, timeframe, since=since, limit=limit)
        except Exception as e:
            print(f"⚠️ WARNING: Fetch failed on chunk, stopping. Error: {e}")
            break
            
        if not ohlcv_chunk:
            break

        all_ohlcv = ohlcv_chunk + all_ohlcv
        fetched_count = len(all_ohlcv)

        # Set 'since' for the next (older) chunk to the timestamp of the oldest candle fetched
        since = ohlcv_chunk[0][0] 
        
        print(f"   -> Fetched {len(ohlcv_chunk)} more. Total: {fetched_count} / Target: {target_limit}")
        
        if len(ohlcv_chunk) < limit:
            print("   -> Reached the start of available history.")
            break
            
        time.sleep(exchange.rateLimit / 1000)

    return all_ohlcv

def fetch_and_process_data(exchange_id: str, symbol: str, timeframe: str, lookback_candles: int) -> Optional[pd.DataFrame]:
    """
    Orchestrates the iterative data fetching and creates the DataFrame.
    """
    print(f"📡 STARTING ITERATIVE FETCH for TARGET {lookback_candles} CANDLES for {symbol} ({timeframe}) on {exchange_id.upper()}...")

    try:
        exchange = getattr(ccxt, exchange_id)()
        fetch_symbol = handle_kraken_symbol(exchange, symbol)
        
        ohlcv = fetch_historical_data(exchange, fetch_symbol, timeframe, lookback_candles)
        
        if not ohlcv:
            print("❌ DATA FETCH FAILED. Could not retrieve any OHLCV data.")
            return None
            
        df = pd.DataFrame(ohlcv, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
        df['date'] = pd.to_datetime(df['timestamp'], unit='ms')
        df.set_index('date', inplace=True)
        df.drop('timestamp', axis=1, inplace=True)
        
        if len(df) < lookback_candles:
            print(f"⚠️ WARNING: Only fetched {len(df)} candles (reached historical limit).")

        print(f"✅ DATA LOADED ({len(df)} candles for {fetch_symbol}).")
        return df

    except Exception as e:
        print(f"❌ DATA FETCH ERROR. Check parameters or network. Error: {e}")
        return None

def generate_features(df: pd.DataFrame) -> pd.DataFrame:
    """
    Applies feature engineering and FIXES the 'Live Prediction Row' issue.
    """
    print("📈 CALCULATING TECHNICAL FEATURES...")
    
    # --- Feature Engineering ---
    df['RSI'] = ta.momentum.RSIIndicator(df['close'], window=14).rsi()
    
    macd_indicator = ta.trend.MACD(df['close'], window_fast=12, window_slow=26, window_sign=9)
    df['MACD_Hist'] = macd_indicator.macd_diff()
    
    df['Log_Volume'] = np.log1p(df['volume']) 

    # --- Normalization ---
    df['RSI_Norm'] = (df['RSI'] - 50) / 50.0
    df['MACD_Norm'] = df['MACD_Hist'] / df['MACD_Hist'].abs().mean()
    df['Vol_Norm'] = df['Log_Volume'].pct_change().clip(-0.5, 0.5)

    # --- Quantum Input Feature (Q_Feature) ---
    df['Q_Feature'] = (df['RSI_Norm'] + df['MACD_Norm'] + df['Vol_Norm']) / 3.0
    df['Q_Feature'] = df['Q_Feature'].clip(-0.5, 0.5)

    # --- Binary Target (Label) ---
    # Target is 1 if the NEXT candle's close is higher than the CURRENT close.
    df['Label'] = (df['close'].shift(-1) > df['close']).astype(int)

    # =================================================================
    # 🛑 CRITICAL FIX: PRESERVE THE LIVE CANDLE (LAST ROW)
    # =================================================================
    
    # 1. Isolate the very last row (the Live candle) BEFORE dropping NaNs.
    # We need this specific row for the prediction, even though its Label is technically unknown.
    df_live_prediction = df.iloc[[-1]].copy()
    
    # 2. Isolate the historical data (everything except the last row).
    df_history = df.iloc[:-1].copy()
    
    # 3. Clean the history. 
    # This removes the first 14-26 rows where RSI/MACD are NaN.
    df_history.dropna(inplace=True)
    
    # 4. Set a placeholder label for the live row (since we don't know the future yet).
    # The predictor script ignores this label for the prediction step anyway.
    df_live_prediction['Label'] = 0 
    
    # 5. Recombine them: Clean History + 1 Live Row
    df_final = pd.concat([df_history, df_live_prediction])

    print(f"   -> History samples (Training): {len(df_history)}")
    print(f"   -> Live sample (Prediction): 1")

    # Select final columns
    df_final = df_final[['RSI_Norm', 'MACD_Norm', 'Vol_Norm', 'Q_Feature', 'Label']]
    
    return df_final

# =========================================================================
# 2. MAIN EXECUTION
# =========================================================================

def main():
    parser = argparse.ArgumentParser(
        description="Quantum Crypto Data Collector (ETH VERSION)",
        formatter_class=argparse.RawTextHelpFormatter
    )
    
    parser.add_argument('-e', '--exchange', type=str, default='kraken', help='Exchange ID')
    # UPDATED DEFAULT TO ETH/USDC
    parser.add_argument('-s', '--symbol', type=str, default='ETH/USDC', help='Trading pair symbol')
    parser.add_argument('-t', '--timeframe', type=str, default='4h', help='Candle interval')
    parser.add_argument('-l', '--lookback', type=int, default=5000, help='Historical candles target')
    parser.add_argument('-o', '--output', type=str, default='crypto_data.csv', help='Output filename')

    args = parser.parse_args()
    
    df = fetch_and_process_data(args.exchange, args.symbol, args.timeframe, args.lookback)
    
    if df is None or df.empty:
        print("🛑 PROCESS ABORTED due to data fetch failure.")
        sys.exit(1)
        
    df_final = generate_features(df)
    
    if df_final.empty:
        print("🛑 PROCESS ABORTED: Feature generation resulted in empty dataset.")
        sys.exit(1)

    df_final.to_csv(args.output, index=False)
    print(f"\n✅ SUCCESS! Saved '{args.output}' with {len(df_final)} samples.")
    print("   The LAST row in this file is now the 'Live' candle for prediction.")
    print("👉 Next step: Upload this file to Colab and run Cell 2.")

if __name__ == '__main__':
    main()
    
